{
  "title": "SPAD Market Intelligence — Operations",
  "uid": "spad-market-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "spad",
    "market",
    "operations"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Market API",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "up{job=\"market-api\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Active unique observations",
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "spad_market_listing_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Qualified neighborhoods",
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "spad_market_qualified_neighborhoods",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Last ingest age (seconds)",
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "spad_market_ingest_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Analytics lag (seconds)",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "spad_market_snapshot_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host memory available %",
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "100*node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU utilization %",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "100*(1-avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host root filesystem available %",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spadmarket"
      },
      "targets": [
        {
          "expr": "100*node_filesystem_avail_bytes{mountpoint=\"/\"}/node_filesystem_size_bytes{mountpoint=\"/\"}",
          "refId": "A"
        }
      ]
    }
  ]
}